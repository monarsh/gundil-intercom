# Gundil Intercom node configuration (/etc/gundil-intercom/node.conf)
# Restart after editing:  sudo systemctl restart gundil-intercom-node

# Name shown on the other intercoms (phones, PCs). Default: hostname.
name = Gate

# Two-way audio: when another intercom connects, the line opens at once
# (door-station behaviour) and both sides talk and listen until one hangs
# up. Set to false to ring instead (press the button to accept).
auto-answer = true

# Who the button connects to: "everyone", or the name of one intercom
# exactly as it appears in the list (e.g. "Office-PC").
target = everyone

# Button on the GPIO header: press to connect, press again to hang up
# (or to accept a ringing call when auto-answer = false).
# Orange Pi PC: physical pin 7 = PA6 = GPIO 6. Raspberry Pi: GPIO 17 =
# physical pin 11. Wire the button between that pin and GND.
# See README.md for other pins.
button-gpio = 6
button-gpio-active-low = true

# Lowers the microphone while the other side talks, so they don't hear
# their own voice echoed back from this speaker. Turn off with a headset.
echo-suppression = true

# Optional LED (with a 330 ohm resistor): on while connected, blinking while
# calling or ringing.
# Orange Pi PC: physical pin 11 = PA1 = GPIO 1; LED cathode to GND (pin 9).
#led-gpio = 1

# auto = use libgpiod tools if installed (supports internal pull-up),
# otherwise /sys/class/gpio.
gpio-backend = auto

# Optional: USB keyboard / foot pedal / USB button as the connect button.
# Find the device with:  ls -l /dev/input/by-id/
#button-input = /dev/input/by-id/usb-XXXX-event-kbd
#button-key = 57     # 57 = Space, 28 = Enter

# Intercom password. Calls are always encrypted; with a password, only
# intercoms with the same password (Settings > Intercom password in the
# app) can connect. Use the same one on every device (no "#" in it).
#password = choose-a-long-passphrase

# Intercoms to add by IP if broadcast discovery doesn't reach them.
#peers = 192.168.1.20, 192.168.1.21:47801

# Connect / hang-up / ring tones.
tones = true
